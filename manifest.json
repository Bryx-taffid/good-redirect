{
  "manifest_version": 3,
  "name": "Good Redirect",
  "version": "0.1.0",
  "action": {
    "default_popup": "static/popup.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}